#include <stdio.h>

int main() {
    // Declaring variables to store the inputs and the final result
    int num1, num2, sum;

    // Prompting the user to input two numbers
    printf("Enter two integers: ");
    
    // Reading and storing the user inputs
    scanf("%d %d", &num1, &num2);

    // Calculating the addition of num1 and num2
    sum = num1 + num2;

    // Displaying the output
    printf("Sum: %d\n", sum);

    return 0;
}
