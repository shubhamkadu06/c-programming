#include <stdio.h>

int main() {
    char op;
    double num1, num2, result;

    // Prompt user for the arithmetic operator
    printf("Enter an operator (+, -, *, /): ");
    scanf(" %c", &op); // Note the space before %c to ignore any leftover newline characters

    // Prompt user for two numbers
    printf("Enter two numbers separated by a space: ");
    scanf("%lf %lf", &num1, &num2);

    // Perform calculation based on the operator
    switch (op) {
        case '+':
            result = num1 + num2;
            printf("Result: %.2lf + %.2lf = %.2lf\n", num1, num2, result);
            break;

        case '-':
            result = num1 - num2;
            printf("Result: %.2lf - %.2lf = %.2lf\n", num1, num2, result);
            break;

        case '*':
            result = num1 * num2;
            printf("Result: %.2lf * %.2lf = %.2lf\n", num1, num2, result);
            break;

        case '/':
            // Error handling: Check for division by zero
            if (num2 == 0.0) {
                printf("Error: Division by zero is not allowed.\n");
            } else {
                result = num1 / num2;
                printf("Result: %.2lf / %.2lf = %.2lf\n", num1, num2, result);
            }
            break;

        // Error handling: Invalid operator input
        default:
            printf("Error: '%c' is an invalid operator.\n", op);
            break;
    }

    return 0;
}
