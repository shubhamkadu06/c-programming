#include <stdio.h>

int main() {
    float celsius, fahrenheit;

    // 1. Take the temperature input in Celsius from the user
    printf("Enter temperature in Celsius: ");
    scanf("%f", &celsius);

    // 2. Apply the conversion formula: (C * 9/5) + 32
    // Note: Writing 9.0 / 5.0 ensures precise floating-point division
    fahrenheit = (celsius * 9.0 / 5.0) + 32.0;

    // 3. Display the result rounded to 2 decimal places
    printf("%.2f°C is equal to %.2f°F\n", celsius, fahrenheit);

    return 0;
}
