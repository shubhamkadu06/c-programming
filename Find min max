#include <stdio.h>

int main()
{
    int n = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    int min = 0;
    int max = 0;

    for (int i = 0; i < n; ++i)
    {
        int k = 0;

        printf("Enter number %d = ", i + 1);
        scanf("%d", &k);

        if (i == 0)
        {
            min = k;
            max = k;
        }
        else
        {
            if (k < min)
                min = k;

            if (k > max)
                max = k;
        }
    }

    printf("min = %d, max = %d\n", min, max);

    return 0;
}
